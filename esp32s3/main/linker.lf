# THE ENGINE RUNS FROM IRAM, NOT FROM FLASH.
#
# MEASURED, and it is what two placement steps eliminated: removing the FX
# chain took 20,465 -> 12,720 cycles/sample at two voices, and then moving the
# voice STATE from PSRAM to internal RAM changed it by 2 cycles (12,720 ->
# 12,718). So the remaining 2x over the instruction model is not data at all.
#
# What is left is INSTRUCTION fetch. The app's code sits in flash, XIP-mapped
# at 0x42000020 (98 KB in this build), behind a small instruction cache. The
# per-sample voice chain touches a large fraction of that code every sample,
# so it thrashes. F4's c/i = 0.95 was measured on a tight harness loop that
# fit in cache; the real engine does not.
#
# Placing the whole main archive (which is where the eb_*.c objects land) in
# IRAM removes the flash fetch entirely.
#
# ⚠⚠ THIS MAPPING IS INERT IN THE SHIPPING BUILD, AND HAS BEEN ALL ALONG.
# MEASURED 2026-08-12 (C3), on the M1 firmware and on the recall firmware,
# with this file present AND with it reverted -- byte-identical placement both
# ways:
#     xtensa-esp32s3-elf-nm build/juno_s3.elf | awk '$1 ~ /^403/' \
#         | grep -cE "eb_|juno_"      ->  0
# ZERO engine or app symbols are in IRAM. app_main is at 0x4200a69c and
# eb_engine_render_range at 0x42011a48 -- both XIP FLASH. DIRAM .text is
# 52,879 B in both builds and that is IDF's own IRAM code, not ours.
#
# THE CAUSE, INFERRED (not yet executed as an A/B): -flto. Under LTO the
# libmain.a members are IR, and the code the link-time plugin generates does
# not carry the archive-member identity ldgen matches on, so `archive:
# libmain.a` selects nothing. Falsify it by building once with -flto removed
# from esp32s3/main/CMakeLists.txt and re-running the nm above.
#
# WHY IT MATTERS BEYOND TIDINESS: the paragraph above this one explains the
# board's 2x-over-model cycles as instruction-cache thrash and says this
# mapping removes it. It does not. So either the thrash is still there and
# unaddressed, or the explanation was wrong -- and 5,410-of-5,442 was measured
# with the engine in FLASH either way. This is playbook defect 32 exactly: a
# knob is not a knob until something reads it, and the way to check is the
# artefact, not the file you wrote.
[mapping:main]
archive: libmain.a
entries:
    # ⚠ NOT `* (noflash_text)`. THE WILDCARD CANNOT SHIP.
    #
    # iram0_0_seg is 341,760 bytes SHARED WITH ALL DRAM, and .bss alone is
    # already 211,760 of it. Moving every libmain.a object into IRAM asks for
    # ~180 KB more than exists, so the wildcard either fails the link or, under
    # -flto, silently does nothing -- which is what it has been doing.
    #
    # So the entries below are an EXPLICIT HOT LIST: the modules the voice loop
    # executes 44,100 times a second. Everything not named here stays in flash
    # by default, including all of recall, which runs about once a second.
    #
    # THIS ONLY WORKS WITHOUT -flto. Under LTO the archive members are IR and
    # ldgen's `archive:`/object matching selects nothing -- MEASURED, both
    # ways, zero engine symbols in IRAM. S3_LTO now defaults OFF for exactly
    # that reason, and the firmware PRINTS which of its own symbols are in IRAM
    # so this can never again be believed rather than checked.
    eb_render (noflash_text)
    eb_dco (noflash_text)
    eb_dco_wt (noflash_text)
    eb_decim (noflash_text)
    eb_vcf_ladder (noflash_text)
    eb_vcf_res (noflash_text)
    eb_vcf_cv (noflash_text)
    eb_envgen (noflash_text)
    eb_vca (noflash_text)
    eb_lfo (noflash_text)
    eb_glide (noflash_text)
    eb_notecv (noflash_text)
    eb_pitch (noflash_text)
    eb_noisemix (noflash_text)
    eb_dcoprep (noflash_text)
    eb_pwm_cv (noflash_text)
    eb_cvgate (noflash_text)
    eb_modcv (noflash_text)
    eb_exp_fork (noflash_text)
    eb_minmax (noflash_text)
    # ---- THE RECALL OBJECTS STAY IN FLASH -----------------------------------
    #
    # `* (noflash_text)` above puts EVERY object of libmain.a into IRAM. With
    # -DS3_RECALL=1 that would drag ~100 KB of once-per-patch code into
    # iram0_0_seg, which is 341,760 bytes SHARED WITH ALL DRAM -- so it either
    # fails the link or starves the heap the coefficient banks live in.
    #
    # These objects run once per patch change, not once per sample. The whole
    # reason the audio path needed IRAM was instruction-cache thrash at 44,100
    # calls a second; a burst 0.25 times a second is served perfectly well by
    # XIP from flash, and the burst's own cost is measured on the board (the
    # BURST: line) rather than assumed either way.
    #
    # A per-object entry OVERRIDES the wildcard above (ldgen takes the most
    # specific match). If one of these ever moves back into IRAM by accident
    # the symptom is a link failure naming dram0_0_seg or iram0_0_seg, which is
    # loud -- unlike the reverse mistake.
    #
    # THESE LINES CHANGE NOTHING TODAY, and saying so is the point: the whole
    # mapping is inert under -flto (see above), MEASURED both ways. They are
    # here so that the day LTO is dropped -- which is the day the wildcard
    # starts working -- 100 KB of once-per-patch recall code does not silently
    # move into a 341,760-byte segment shared with every byte of DRAM.
    juno_apply (default)
    juno_curve (default)
    juno_driver (default)
    juno_note (default)
    delay_recall (default)
    reverb_recall (default)
    chorus_recall (default)
    finefx_recall (default)
    effect_modes (default)
    hpf_type_lut (default)
    ebdev (default)
    eb_recall (default)
    eb_devseq (default)
    eb_coefs (default)
    eb_master_coefs (default)
    eb_chorus_shim (default)

# noflash_TEXT, not noflash. `noflash` moves rodata into DRAM as well, and
# this component's rodata is the 1.69 MB embedded coefficient blob -- the
# link failed with `dram0_0_seg overflowed by 1631392 bytes`, which is that
# blob almost exactly. Only the CODE needs to leave flash; constants are read
# through the data cache and were never the measured cost.
