CONFIG_IDF_TARGET="esp32s3"

# (PSRAM enabled below for the FX state)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# 115200 matches the miniterm line in CLAUDE.md.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The JUNO FX state (~730 KB, mostly the delay-core and reverb rings) lives in
# PSRAM. ESP32-S3R8 (the user's chip: "Embedded PSRAM 8MB (AP_3v3)") = octal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
