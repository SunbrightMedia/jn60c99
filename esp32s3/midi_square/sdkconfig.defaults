CONFIG_IDF_TARGET="esp32s3"

# (PSRAM enabled below for the FX state)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# 115200 matches the miniterm line in CLAUDE.md.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The JUNO FX state (~730 KB, mostly the delay-core and reverb rings) lives in
# PSRAM. ESP32-S3R8 (the user's chip: "Embedded PSRAM 8MB (AP_3v3)") = octal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CACHE: the reverb's 200 KB state is in PSRAM. Each tap walks its ring one
# float per sample, so a 64 B line serves 16 samples per miss (32 B: 8). The
# biggest data cache leaves room for every tap's line at once.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_8WAYS=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_8WAYS=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_32B=y
