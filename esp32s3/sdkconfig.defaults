CONFIG_IDF_TARGET="esp32s3"
# 8 MB PSRAM (octal) -- the delay rings need 6.1 MB and this is the
# allocation the whole memory plan hinges on. If the actual module is quad,
# change SPIRAM_MODE_OCT to QUAD; the malloc path is the same.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# 240 MHz, the budget's denominator
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# the FPU stays on in the main task; no lazy context tricks
CONFIG_FREERTOS_FPU_IN_ISR=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# big FX states (chorus/delay/reverb, ~470 KB) live in PSRAM .bss -- the
# product keeps its rings there, so the cycle number should too
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# custom table: the listen app embeds a 1.69 MB coefficient blob
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Biggest instruction cache and longest line: the engine's per-sample code
# footprint is what the board measured as the dominant cost.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_64B=y
CONFIG_ESP32S3_ICACHE_ASSOCIATED_WAYS_8=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# THE IDLE WATCHDOG IS OFF ON PURPOSE (2026-08-11).
# The listen firmware's render loop saturates its core by design -- that is
# what a real-time audio loop does. It used to call vTaskDelay(1) once per
# 128-frame chunk to keep IDLE alive; one FreeRTOS tick is 10 ms and a chunk
# is 2.902 ms of audio, so the harness slept 3.4x the sample period and the
# wall-clock verdict measured the sleep instead of the engine. Worse, the
# state was self-sustaining: while behind, the I2S write never blocks, so no
# condition on the write could ever switch the sleep off again.
# With the watchdog off the loop blocks only in i2s_channel_write, which is a
# real blocking wait for DMA space and yields correctly once the engine is
# ahead of the codec.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_CONSOLE_UART_BAUDRATE=921600

# USB-OTG and USB-Serial-JTAG SHARE one PHY and one pad pair on the S3.
# IDF starts USJ as a secondary console before app_main, so it owns the pads
# and USB MIDI can never attach. The console stays on UART0 (the other USB-C
# socket, through the bridge chip), so nothing is lost by turning USJ off.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
